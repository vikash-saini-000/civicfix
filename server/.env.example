# Copy to .env for local development. Placeholders only; never commit real values.

# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Required. Use a replica set (?replicaSet=rs0) when transactions are needed (from Phase 6).
# Example with credentials: mongodb://<user>:<password>@localhost:27017/civicfix?authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017/civicfix

# Comma-separated exact origins allowed by CORS (required, https only, in production).
CORS_ORIGINS=http://localhost:5173

# Max JSON request body (1kb to 1mb).
JSON_BODY_LIMIT=100kb

# Number of reverse proxies in front of the API (0 when running directly). Needed for correct client IPs.
TRUST_PROXY=0

# --- Authentication ---
# Required. Random string of at least 32 characters, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access token lifetime in seconds (60-3600) and refresh session lifetime in days (1-30).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Refresh cookie flags. COOKIE_SECURE defaults to true in production (and cannot be false there).
# Use COOKIE_SAMESITE=none (with COOKIE_SECURE=true) only if the frontend is on a different site.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- AI analysis (docs/ai/AI_ANALYSIS_PIPELINE.md) ---
# disabled = no AI calls; complaints go to manual triage, duplicate checks still run.
AI_PROVIDER=disabled
# Required when AI_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=30000

AI_MAX_ATTEMPTS=3
# --- Evidence storage (docs/api/EVIDENCE_VERIFICATION_DISPUTES.md) ---
# disabled = uploads answer 503; local = files under STORAGE_LOCAL_DIR (dev / single server).
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# --- Verification policy (needs product-owner approval before changing) ---
# Approve resolutions without a human when every rule passes.
AUTO_APPROVE_RESOLUTIONS=false
# Days after resolution in which citizens may dispute and before staff may close.
DISPUTE_WINDOW_DAYS=14

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Time allowed for in-flight requests during shutdown, and for the initial DB connection.
SHUTDOWN_TIMEOUT_MS=10000
DB_SERVER_SELECTION_TIMEOUT_MS=10000
