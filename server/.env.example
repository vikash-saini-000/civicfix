# Copy to .env for local development. Placeholders only; never commit real values.

# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Required. Use a replica set (?replicaSet=rs0) when transactions are needed (from Phase 6).
# Example with credentials: mongodb://<user>:<password>@localhost:27017/civicfix?authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017/civicfix

# Comma-separated exact origins allowed by CORS (required, https only, in production).
CORS_ORIGINS=http://localhost:5173

# Max JSON request body (1kb to 1mb).
JSON_BODY_LIMIT=100kb

# Number of reverse proxies in front of the API (0 when running directly). Needed for correct client IPs.
TRUST_PROXY=0

# --- Authentication ---
# Required. Random string of at least 32 characters, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access token lifetime in seconds (60-3600) and refresh session lifetime in days (1-30).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Refresh cookie flags. COOKIE_SECURE defaults to true in production (and cannot be false there).
# Use COOKIE_SAMESITE=none (with COOKIE_SECURE=true) only if the frontend is on a different site.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- AI analysis (docs/ai/AI_ANALYSIS_PIPELINE.md) ---
# disabled = no AI calls; complaints go to manual triage, duplicate checks still run.
AI_PROVIDER=disabled
# When AI_PROVIDER=anthropic, set exactly ONE of these keys. Never commit a real key.
#   ANTHROPIC_API_KEY  -> calls api.anthropic.com directly.
#   AICREDITS_API_KEY  -> calls the same Messages API through the AiCredits.in prepaid gateway
#                         (https://api.aicredits.in, fixed in code). AI_MODEL is then required and must be an
#                         AiCredits catalog ID such as anthropic/claude-sonnet-4.6 (https://aicredits.in/docs/models).
ANTHROPIC_API_KEY=
AICREDITS_API_KEY=
# Direct-API default is claude-opus-5-5.
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=30000
# single = one classification call per complaint (cheapest).
# agent  = Claude plans with read-only tools (similar complaints, department workload, available staff)
#          and proposes an assignee; backend rules still decide. Uses several calls per complaint.
AI_TRIAGE_MODE=single
# Max model calls per agent run (2-10).
AI_AGENT_MAX_TURNS=6

AI_MAX_ATTEMPTS=3
# strict = also refuse files with only "some" signs of editing/generation, or an editing-app tag (strongest,
#          but may refuse some genuine blurry or low-light photos).
# block  = refuse photos/videos that look AI-generated or edited (checked at upload, nothing stored).
# flag   = store them and only mark them for staff review.
MEDIA_UPLOAD_GATE=block
# camera = photos/videos must be taken with the in-app camera: the gallery is not offered, and each file
#          carries a signed camera-session token plus the capture time and GPS from that moment.
# any    = gallery files are also accepted (e.g. for scripts or desktop testing).
# The in-app camera needs HTTPS (or localhost) in the browser.
EVIDENCE_CAPTURE=camera
# How long a camera session stays valid after the camera opens, in seconds (60-7200).
CAPTURE_SESSION_TTL_SECONDS=1800
# --- Evidence storage (docs/api/EVIDENCE_VERIFICATION_DISPUTES.md) ---
# disabled = uploads answer 503; local = files under STORAGE_LOCAL_DIR (dev / single server);
# cloudinary = Cloudinary (production, required on Vercel). Files are stored as "authenticated" assets,
# never public; browsers upload straight to Cloudinary and the API checks each file before keeping it.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
# With STORAGE_PROVIDER=cloudinary: the "API environment variable" from the Cloudinary dashboard,
# cloudinary://<api_key>:<api_secret>@<cloud_name>  (or set CLOUDINARY_CLOUD_NAME / _API_KEY / _API_SECRET).
CLOUDINARY_URL=
# Top-level folder for this environment, e.g. civicfix or civicfix-staging.
CLOUDINARY_FOLDER=civicfix

# --- Daily maintenance (Vercel Cron) ---
# Vercel calls GET /api/v1/internal/maintenance once a day with "Authorization: Bearer <CRON_SECRET>":
# finishes leftover AI/privacy jobs, records SLA breaches, deletes abandoned staged uploads.
# 32+ random characters. Unset = endpoint disabled.
CRON_SECRET=

# --- Human check (Cloudflare Turnstile) ---
# turnstile = register, login and new complaints need a Turnstile token, verified here with Cloudflare's
# Siteverify API. The client needs the matching VITE_TURNSTILE_SITE_KEY.
CAPTCHA_PROVIDER=disabled
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames the widget runs on, e.g. civicfix.pages.dev,civicfix.in (empty = any).
TURNSTILE_HOSTNAMES=

# --- Video evidence (ffmpeg) ---
# ffmpeg and ffprobe are used to read video length/GPS/time, pull frames for the AI checks and make the
# privacy copy (faces and number plates blurred, metadata removed). A name on PATH or a full path.
# Without them videos are stored with metadata-only checks.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Longest accepted video, in seconds (5-300).
MAX_VIDEO_SECONDS=60

# --- Addresses for map points ---
# nominatim = street addresses from OpenStreetMap (server-side, cached, max 1 request/s per their policy);
# disabled  = only the ward and nearest mapped place. Off automatically when NODE_ENV=test.
GEOCODER=nominatim
GEOCODER_URL=https://nominatim.openstreetmap.org
# Identify the app (and ideally a contact) to the Nominatim operator.
GEOCODER_USER_AGENT=CivicFix/0.1 (civic complaint platform)

# --- Verification policy (needs product-owner approval before changing) ---
# Approve resolutions without a human when every rule passes.
AUTO_APPROVE_RESOLUTIONS=false
# Days after resolution in which citizens may dispute and before staff may close.
DISPUTE_WINDOW_DAYS=14

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Time allowed for in-flight requests during shutdown, and for the initial DB connection.
SHUTDOWN_TIMEOUT_MS=10000
DB_SERVER_SELECTION_TIMEOUT_MS=10000
