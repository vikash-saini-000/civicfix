# Copy to .env for local development. Placeholders only; never commit real values.

# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Required. Use a replica set (?replicaSet=rs0) when transactions are needed (from Phase 6).
# Example with credentials: mongodb://<user>:<password>@localhost:27017/civicfix?authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017/civicfix

# Comma-separated exact origins allowed by CORS (required, https only, in production).
CORS_ORIGINS=http://localhost:5173

# Max JSON request body (1kb to 1mb).
JSON_BODY_LIMIT=100kb

# Number of reverse proxies in front of the API (0 when running directly). Needed for correct client IPs.
TRUST_PROXY=0

# --- Authentication ---
# Required. Random string of at least 32 characters, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access token lifetime in seconds (60-3600) and refresh session lifetime in days (1-30).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Refresh cookie flags. COOKIE_SECURE defaults to true in production (and cannot be false there).
# Use COOKIE_SAMESITE=none (with COOKIE_SECURE=true) only if the frontend is on a different site.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Time allowed for in-flight requests during shutdown, and for the initial DB connection.
SHUTDOWN_TIMEOUT_MS=10000
DB_SERVER_SELECTION_TIMEOUT_MS=10000
