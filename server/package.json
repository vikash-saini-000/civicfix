{
  "name": "civicfix-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:sync-indexes": "tsx src/scripts/syncIndexes.ts",
    "user:create": "tsx src/scripts/createUser.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "user:create:prod": "node dist/scripts/createUser.js",
    "db:sync-indexes:prod": "node dist/scripts/syncIndexes.js",
    "ai:live": "tsx tests/live/aiAgenticFlow.ts",
    "e2e:live": "tsx tests/live/e2eLive.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@node-rs/argon2": "^2.2.2",
    "@vercel/functions": "3.9.11",
    "cloudinary": "2.11.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "mongoose": "^9.11.4",
    "pino": "^10.4.0",
    "sharp": "^0.34.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server-core": "^11.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "main": "dist/server.js"
}
