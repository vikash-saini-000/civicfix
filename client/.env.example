# http (default) talks to the CivicFix backend. mock uses local demo data for UI work without a server.
VITE_CIVICFIX_API_MODE=http

# Leave empty to use the same origin. In development, Vite proxies /api to http://localhost:4000
# (see vite.config.ts). Set an origin only for a separately hosted API.
VITE_CIVICFIX_API_BASE_URL=
VITE_CIVICFIX_API_TIMEOUT_MS=15000
VITE_CIVICFIX_AUTH_MODE=http

# Cloudflare Turnstile site key (public). Set it together with CAPTCHA_PROVIDER=turnstile on the server;
# leave empty to hide the human check. Cloudflare's always-pass test key: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
