# Use mock data locally, or set this to http when the backend is available.
VITE_CIVICFIX_API_MODE=mock

# Optional for same-origin deployments. Set an origin such as http://localhost:3000 for a separate API.
VITE_CIVICFIX_API_BASE_URL=
VITE_CIVICFIX_API_TIMEOUT_MS=10000
VITE_CIVICFIX_AUTH_MODE=mock
